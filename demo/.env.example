# stackdoctor config for the demo (copy to demo/.env). Uses the read-only role from postgres/init.sql.
DATABASE_URL=postgresql://stackdoctor_ro:readonly@localhost:55432/shop
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/0
CELERY_RESULT_BACKEND=redis://localhost:56379/1
LOG_SOURCES=docker:sd-demo-worker,docker:sd-demo-postgres,docker:sd-demo-api
EXPECTED_WORKERS=1
QUEUE_THRESHOLD=20
LONG_TASK_S=10
LONG_QUERY_S=10
